# =============================================================================
# Fieldnote: environment variables
# Copy to .env.local and fill in. Never commit real values.
# Every variable the app reads is listed here; there are no others.
# =============================================================================

# --- Demo mode ---------------------------------------------------------------
# Must be exactly "true". Demo mode is the only supported mode: it enables the
# "Enter demo" sign-in button and pins the reminder send mode so it can never
# be "live". With any other value the sign-in page explains that demo mode is
# off and nobody can get in.
DEMO_MODE=true

# Password of the demo@example.com user you create in Supabase Auth
# (Authentication -> Users -> Add user, "Auto confirm user" on).
# Server-only. The browser never sees it: the visitor presses a button and the
# server calls signInWithPassword.
DEMO_USER_PASSWORD=

# --- Supabase ----------------------------------------------------------------
# Project Settings -> API.
# The URL and anon key are public by design. The anon key is used for Auth
# only; it has no access to any fn_* schema.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service-role key is a SECRET and is only read on the server. All data
# access goes through it, after the role guard has run.
# Remember: Project Settings -> API -> Exposed schemas must include
#   fn_app, fn_analytics
# (and must NOT include fn_demo).
SUPABASE_SERVICE_ROLE_KEY=

# --- Local verification only ---------------------------------------------------
# Treats every request as demo@example.com WITHOUT Supabase Auth, so the app
# can run against the Docker Postgres + PostgREST stack in
# docker-compose.local.yml, which has no Auth service.
# It is REFUSED (ignored) when NODE_ENV=production and whenever VERCEL,
# VERCEL_ENV or VERCEL_URL is set, and it needs DEMO_MODE=true.
# Leave it unset everywhere except a local smoke test.
# DEMO_AUTH_BYPASS_FOR_LOCAL_TESTS=true
